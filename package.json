{
  "name": "koach",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run && pnpm --filter @koach/mobile test",
    "format": "prettier --check .",
    "lint:sh": "shellcheck -x infra/*.sh",
    "test:unit": "vitest run",
    "dev:api": "GCP_PROJECT=koach-dev-8cf0a5 EMAIL_DEV_ECHO=1 pnpm --filter @koach/api dev",
    "dev:web": "pnpm --filter @koach/mobile web",
    "dev": "pnpm run \"/^dev:(api|web)$/\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "shellcheck": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
