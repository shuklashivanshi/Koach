# koach-dev environment. Committed: contains no secrets.
# PROJECT_ID is generated on the first bootstrap run (project IDs are globally unique).
PROJECT_ID=
BILLING_ACCOUNT=
REGION=asia-south1
AR_REPO=koach
SQL_INSTANCE=koach-pg
SQL_TIER=db-f1-micro
DB_NAME=koach
DB_USER=koach_app
BUDGET_AMOUNT=2000
BUDGET_CURRENCY=INR
ANDROID_PACKAGE=com.koach.app
# Filled by bootstrap from google-services.json once the Google sign-in provider is enabled.
GOOGLE_WEB_CLIENT_ID=
# Private GitHub repo used by the Cloud Build trigger, e.g. https://github.com/<owner>/koach.git
GITHUB_REPO_URL=
